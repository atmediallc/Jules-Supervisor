{
  "name": "jules-supervisor-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:ci": "vitest run --coverage",
    "test:load": "k6 run tests/load/load-test.js",
    "db:migrate": "tsx packages/db/src/migrate.ts",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^3.0.7",
    "@types/pg": "^8.23.1",
    "bullmq": "^6.3.3",
    "eslint": "^10.9.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.0.7"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "engines": {
    "node": ">=20.0.0"
  }
}
